{
  "name": "stet",
  "private": true,
  "type": "module",
  "description": "Local visual regression checks for WordPress sites.",
  "bin": {
    "stet": "bin/stet"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/stet.test.ts"
  },
  "dependencies": {
    "@playwright/test": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  }
}
